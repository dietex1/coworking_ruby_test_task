<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm mt-4">
      <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Add a New Room</h4>
      </div>
      <div class="card-body">
        <%= form_with(model: @room, local: true) do |f| %>
          <% if @room.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @room.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :name, "Room Name", class: "form-label fw-bold" %>
            <%= f.text_field :name, class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :capacity, "Capacity (seats)", class: "form-label fw-bold" %>
            <%= f.number_field :capacity, class: "form-control", min: 1 %>
          </div>

          <div class="d-grid">
            <%= f.submit "Create Room", class: "btn btn-dark btn-lg" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mt-3 text-center">
      <%= link_to "&larr; Back to list".html_safe, root_path, class: "text-decoration-none" %>
    </div>
  </div>
</div>