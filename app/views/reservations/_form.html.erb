<%= form_with(model: reservation, local: true) do |f| %>
  <% if reservation.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading">Error! Seat could not be booked:</h6>
      <ul class="mb-0">
        <% reservation.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :room_id %>

  <div class="mb-3">
    <%= f.label :guest_name, "Employee / Guest Name", class: "form-label fw-bold" %>
    <%= f.text_field :guest_name, class: "form-control", placeholder: "e.g., John Doe" %>
  </div>

  <div class="mb-3">
    <%= f.label :start_date, "Start Date & Time", class: "form-label fw-bold" %>
    <%= f.datetime_field :start_date, class: "form-control" %>
  </div>

  <div class="mb-4">
    <%= f.label :end_date, "End Date & Time", class: "form-label fw-bold" %>
    <%= f.datetime_field :end_date, class: "form-control" %>
  </div>

  <div class="d-grid">
    <%= f.submit "Confirm Booking", class: "btn btn-success btn-lg" %>
  </div>
<% end %>