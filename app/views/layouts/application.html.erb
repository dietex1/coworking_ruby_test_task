<!DOCTYPE html>
<html>
<head>
  <title>Coworking / Meeting Rooms</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <%= stylesheet_link_tag "application" %>
</head>

<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <%= link_to "Meeting Rooms", root_path, class: "navbar-brand" %>
    <div class="d-flex">
      <%= link_to "Add Room", new_room_path, class: "btn btn-outline-light btn-sm" %>
    </div>
  </div>
</nav>

<div class="container">
  <% if notice %>
    <div class="alert alert-success alert-dismissible fade show"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="alert alert-danger alert-dismissible fade show"><%= alert %></div>
  <% end %>

  <%= yield %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>